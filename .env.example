# DeepSeek（OpenAI 兼容接口）
DEEPSEEK_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# 搜索工具选择: dummy | duckduckgo | local
SEARCH_BACKEND=dummy
# local 模式的知识库路径（行业数据，JSON 数组格式见 tools/search.py 注释）
# LOCAL_KB_PATH=data/industry_kb.json

# 可复现实验：二选一。快照文件默认不入 Git
# SEARCH_SNAPSHOT_PATH=eval/snapshots/search_snapshot.json
# RECORD_SEARCH_SNAPSHOT_PATH=eval/snapshots/search_snapshot.json

# 研究参数
# MAX_SUBQUESTIONS=5
# MAX_EVIDENCE_PER_SUB=3

# 上下文预算（字符）：单个章节的证据总长超限时自动压缩（首部保留截断）
# CONTEXT_BUDGET_CHARS=6000
